# API Keys for Interview KB Ingestion
# Copy this file to .env and fill in your API keys

# SEC EDGAR API - No key required, but add email for identification
SEC_USER_AGENT=your-email@example.com

# PubMed E-utilities API
# Get key at: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=your_pubmed_api_key_here

# ClinicalTrials.gov API - No key required
# Uses public API: https://clinicaltrials.gov/api/

# Google Patents - Using SerpAPI or similar
# 250 calls per month
# Get key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# YouTube Data API v3
# Get key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API for embeddings (text-embedding-3-large) and generation (GPT-4o)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API for Claude models (Claude 3.5 Sonnet)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Generation settings
GENERATION_MODEL=gpt-4o  # Options: gpt-4o, claude-3-5-sonnet-20241022

# Data storage settings
DATA_DIR=data/raw
INDEX_DIR=data/index
